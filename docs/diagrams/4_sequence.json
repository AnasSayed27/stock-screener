  "cards": [
    {
      "dot": "cyan",
      "title": "Asynchronous Thread Decoupling",
      "items": [
        "FastAPI endpoint spawns a daemon worker thread and immediately returns an NDJSON StreamingResponse",
        "The event loop is never blocked by long-running LLM reasoning or Tavily searches",
        "Thread-safe queue.Queue buffers progress updates between synchronous worker and async generator"
      ]
    },
    {
      "dot": "rose",
      "title": "Client-Disconnect Token Guard",
      "items": [
        "The async generator actively polls request.is_disconnected() on every iteration",
        "Detects tab closures or route switches immediately and sets the global cancellation flag",
        "Aborts in-flight Gemini API calls to prevent wasted LLM tokens and API charges"
      ]
    },
    {
      "dot": "emerald",
      "title": "Crash-Safe Atomic Commit",
      "items": [
        "Completed discovery results are committed using temporary file swap and os.fsync",
        "Cancelling or process death never leaves half-written or corrupted JSON dossiers",
        "Worker pushes sentinel None to cleanly terminate the generator and HTTP connection"
      ]
    }
  ]
