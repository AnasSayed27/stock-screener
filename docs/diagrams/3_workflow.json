  "cards": [
    {
      "dot": "cyan",
      "title": "5-Phase Deep Research Loop",
      "items": [
        "Phase 1 Divergent Scan: Identifies 2-3 parallel hypotheses across supply chain layers",
        "Phase 2-3 Deep Dive: Forensic audit of order books, capex filings, and capacity expansion",
        "Real-time NDJSON streaming delivers agent reasoning steps to the browser UI"
      ]
    },
    {
      "dot": "rose",
      "title": "Evaluator-Critic Anti-Hallucination Gate",
      "items": [
        "Phase 4 invokes an independent Critic LLM to verify all claims against primary sources",
        "If factual gaps or unbacked claims exist, the Depth Loop re-triggers targeted searches",
        "Prevents unverified promotional hype from contaminating the final thesis"
      ]
    },
    {
      "dot": "emerald",
      "title": "Multi-Tool Grounding & Synthesis",
      "items": [
        "Tavily Search API unearths real-time disclosures, management concalls, and news",
        "yfinance tool verifies revenue growth, margin expansion, and debt numbers",
        "Master Synthesis combines >=7 discovery runs to rank cross-strategy portfolio picks"
      ]
    }
